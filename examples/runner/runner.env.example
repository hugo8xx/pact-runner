# pact-runner settings. Keep the real file outside git (it holds the runner's token), e.g.
# ~/.config/pact/runner-<project>.env with mode 600.

PACT_URL=https://board.example.com
PACT_RUNNER_AGENT=runner-myproject
PACT_RUNNER_TOKEN=pact_xxxxxxxx

# A clone the runner owns; every task gets its own git worktree on branch runner/<task>.
PACT_RUNNER_REPO=~/pact-runner/repos/myproject

# Billing: subscription uses the `claude` login on this machine and strips any API key from the
# child's environment. api_key bills the key below instead (one switch if plan terms change).
PACT_RUNNER_AUTH=subscription
# PACT_RUNNER_ANTHROPIC_API_KEY=sk-ant-...

# Ceilings per run and per day.
PACT_RUNNER_MAX_TURNS=40
PACT_RUNNER_RUN_TIMEOUT_MINUTES=30
PACT_RUNNER_CONCURRENCY=1
PACT_RUNNER_MAX_RUNS_PER_DAY=20

# Keep part of the subscription for the owner: no new run once a quota window is this used.
PACT_RUNNER_RESERVE_FIVE_HOUR=0.7
PACT_RUNNER_RESERVE_SEVEN_DAY=0.8
# Local hours with no new runs, e.g. while the owner works:
# PACT_RUNNER_QUIET_HOURS=9-18

# Sub-agents: other runner agents a session may hand subtasks to (each runs its own pact-runner).
# PACT_RUNNER_WORKERS=worker-myproject
# PACT_RUNNER_MAX_WAIT_HOURS=24

# Optional
# PACT_RUNNER_MODEL=sonnet
# PACT_RUNNER_ROLE_FILE=~/.config/pact/runner-role.md
# PACT_RUNNER_ENTRY_HOOK=/path/to/pact-board/hooks/pact-hook.sh runner-myproject PostToolUse
# PACT_RUNNER_TAKE_OPEN=1   # also take open tasks delegated to nobody
